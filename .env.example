# NextGen platform environment variables.
# Copy this file to `.env` for local runs:  cp .env.example .env

# --- Required ---
# Random secret for signing session cookies (itsdangerous).
# Render: auto-generated by render.yaml (generateValue: true).
# Local: any long random string, e.g. openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- Server ---
# Port the app listens on. Render injects PORT automatically (default 8000).
PORT=8000

# Directory for the SQLite database (data/nextgen.db) and job files.
# Docker: /app/data (see Dockerfile). Local default: ./data
DATA_DIR=./data

# --- Optional: SMTP email (real sign-in emails) ---
# If SMTP_HOST is unset, the app runs in DEMO_AUTH mode and the sign-in
# code is shown on screen instead of emailed. No keys needed to try the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: Hugging Face API token ---
# Improves script quality via hosted LLM. Without it, the built-in
# template engine is used instead — still fully functional.
HF_API_TOKEN=

# Force demo-code auth even when SMTP is configured ("1"), or force real
# email mode ("0"). Default is auto: "1" when SMTP_HOST is unset, else "0".
DEMO_AUTH=

# Permissive CORS origins, comma-separated. Unset = no CORS middleware
# (the frontend is served same-origin from /static).
CORS_ORIGINS=

# --- Optional: YouTube Data API key (reserved) ---
# The current version uses yt-dlp (zero keys required) for channel analysis.
# Reserved for a future reliability upgrade; safe to leave unset.
YOUTUBE_API_KEY=
